24-03":"2024-03","2024-04":"2024-04","2024-05":"2024-05","2024-06":"2024-06","2024-07":"2024-07","2024-08":"2024-08","2024-09":"2024-09","2024-10":"2024-10","2024-11":"2024-11","2024-12":"2024-12","2025-01":"2025-01","2025-02":"2025-02","2025-03":"2025-03","2025-04":"2025-04","2025-05":"2025-05","2025-06":"2025-06","2025-07":"2025-07","2025-08":"2025-08","2025-09":"2025-09","2025-10":"2025-10","2025-11":"2025-11","2025-12":"2025-12"}}}},"extension":{"lang":"EN","description":"<p>The Harmonised Index of Consumer Prices (HICP) measures price changes of various consumer goods and services over time (inflation). This dataset is compiled according to the European Classification&nbsp;of Individual Consumption&nbsp;According to Purpose (ECOICOP)&nbsp;ver. 2, available in base years 2025=100 and 2015=100.&nbsp;&nbsp;</p><p>This dataset includes&nbsp;four monthly&nbsp;indicators:&nbsp;</p><ul><li>the index, measuring price changes in relation to a base year&nbsp;</li><li>the annual rate of change,&nbsp;representing the percentage change in a reference month compared to the same month of the previous year (also called annual inflation)&nbsp;</li><li>the monthly rate of change,&nbsp;representing the percentage change in consumer price indices in a reference month compared to the previous month (also called monthly inflation)</li><li>the 12-month average rate of change,&nbsp;comparing the average index over a 12-month period to the average index previous 12-month period.</li></ul><p><br></p><p>All the rates are calculated from the monthly HICP indices.&nbsp;</p>","id":"PRC_HICP_MINR","agencyId":"ESTAT","version":"1.0","datastructure":{"id":"PRC_HICP_MINR","agencyId":"ESTAT","version":"26.1"},"annotation":[{"type":"CREATED","date":"2026-01-27T09:31:20+0100"},{"type":"DISSEMINATION_DOI_XML","title":"<adms:identifier xmlns:adms=\"http://www.w3.org/ns/adms#\" xmlns:skos=\"http://www.w3.org/2004/02/skos/core.html\" xmlns:dct=\"http://purl.org/dc/terms/\" xmlns:rdf=\"http://www.w3.org/1999/02/22-rdf-syntax-ns#\"><adms:Identifier rdf:about=\"https://doi.org/10.2908/PRC_HICP_MINR\"><skos:notation rdf:datatype=\"http://purl.org/spar/datacite/doi\">10.2908/PRC_HICP_MINR</skos:notation><dct:creator rdf:resource=\"http://publications.europa.eu/resource/authority/corporate-body/ESTAT\"/><dct:issued rdf:datatype=\"http://www.w3.org/2001/XMLSchema#date\">2026-01-27</dct:issued></adms:Identifier></adms:identifier>"},{"type":"DISSEMINATION_EXPLANATORY_LINK","title":"text-category","href":"https://ec.europa.eu/eurostat/databrowser-backend/api/public/explanatory-notes/get/Info_note_HICP_COICOP18_20260128.pdf"},{"type":"DISSEMINATION_EXPLANATORY_LINK","title":"text-category","href":"https://ec.europa.eu/eurostat/databrowser-backend/api/public/explanatory-notes/get/Info_note_HICP_COICOP18_20260128.pdf"},{"type":"DISSEMINATION_EXPLANATORY_LINK","title":"text-category","href":"https://ec.europa.eu/eurostat/databrowser-backend/api/public/explanatory-notes/get/Info_note_HICP_COICOP18_20260128.pdf","text":"Information note"},{"type":"DISSEMINATION_OBJECT_TYPE","title":"DATASET"},{"type":"DISSEMINATION_TIMESTAMP_DATA","date":"2026-11-18T11:00:00+0100"},{"type":"DISSEMINATION_TIMESTAMP_GLOBAL","date":"2026-11-18T11:00:00+0100"},{"type":"DISSEMINATION_TIMESTAMP_PLANNED","date":"2026-11-18T11:00:00+0100"},{"type":"ESMS_HTML","title":"Explanatory texts (metadata)","href":"https://ec.europa.eu/eurostat/cache/metadata/en/prc_hicp_esms.htm"},{"type":"ESMS_SDMX","title":"Explanatory texts (metadata)","href":"https://ec.europa.eu/eurostat/api/dissemination/files?file=metadata/prc_hicp_esms.sdmx.zip"},{"type":"OBS_COUNT","title":"22577512"},{"type":"OBS_PERIOD_OVERALL_LATEST","title":"2026-10"},{"type":"OBS_PERIOD_OVERALL_OLDEST","title":"1996-01"},{"type":"SOURCE_INSTITUTIONS","text":"Eurostat"},{"type":"UPDATE_DATA","date":"2026-11-18T11:00:00+0100"},{"type":"UPDATE_STRUCTURE","date":"2026-11-04T11:00:00+0100"}],"positions-with-no-data":{"freq":[],"unit":[],"coicop18":[],"